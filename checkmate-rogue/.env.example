# ==============================================================================
# Checkmate Rogue — Environment Configuration (.env.example)
# Copy this file to .env or .env.local to customize your local setup.
# Never commit real credentials, tokens, or machine-specific secrets.
# ==============================================================================

# Ollama local inference endpoint URL
# Default local instance is typically http://127.0.0.1:11434/api/generate
# You can also use the relative Vite proxy path: /ollama/api/generate
VITE_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate

# The Ollama model to use for rival observations and dialogue
# Recommended: gemma2:2b (fast, ~1.6 GB) or gemma2:9b
# Make sure to run `ollama pull <model>` prior to selecting Local Gemma mode.
VITE_OLLAMA_MODEL=gemma2:2b

# Request timeout in milliseconds (default: 10000ms for gameplay to accommodate CPU cold starts)
VITE_OLLAMA_TIMEOUT_MS=10000

# ==============================================================================
# HOSTED DEPLOYMENT FLAG
# ==============================================================================
# Set VITE_IS_HOSTED=true when building for a public static hosting environment.
# When true:
#   - The "Local Gemma" dialogue mode is hidden and disabled.
#   - No requests are ever made to localhost or any Ollama endpoint.
#   - Scripted deterministic dialogue is used exclusively.
#
# For local development, leave this unset or set to false.
# VITE_IS_HOSTED=false
